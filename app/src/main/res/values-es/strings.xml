    <!-- API key guide -->
    <string name="key_guide_title">Tu clave de IA gratis</string>
    <string name="key_intro_title">¿Por qué una clave?</string>
    <string name="key_intro_body">ConceptGames usa la IA Gemini de Google para crear tus juegos. Gemini tiene un nivel gratuito: crea tu propia clave en unos dos minutos. No necesitas tarjeta de crédito y la clave se guarda cifrada solo en este teléfono.</string>
    <string name="key_step_open_title">Abre Google AI Studio</string>
    <string name="key_step_open_body">Inicia sesión con cualquier cuenta de Google.</string>
    <string name="key_open_ai_studio">Abrir Google AI Studio</string>
    <string name="key_step_create_title">Crea una clave de API</string>
    <string name="key_step_create_body">Toca “Create API key” (Crear clave de API). Si te pide elegir un proyecto, el predeterminado sirve, o crea uno nuevo.</string>
    <string name="key_step_copy_title">Copia la clave</string>
    <string name="key_step_copy_body">Es un código largo que normalmente empieza con “AIza”. Usa el botón de copiar que está a su lado.</string>
    <string name="key_step_paste_title">Pégala aquí</string>
    <string name="key_step_paste_body">La comprobamos con Google antes de guardarla.</string>
    <string name="key_field_label">Clave de API de Gemini</string>
    <string name="key_show">Mostrar clave</string>
    <string name="key_hide">Ocultar clave</string>
    <string name="key_paste">Pegar</string>
    <string name="key_test">Probar y guardar</string>
    <string name="key_testing">Comprobando tu clave con Google…</string>
    <string name="key_valid_title">¡Tu clave funciona!</string>
    <plurals name="key_valid_body">
        <item quantity="one">Ya está guardada. Tienes %1$d modelo disponible.</item>
        <item quantity="many">Ya está guardada. Tienes %1$d modelos disponibles.</item>
        <item quantity="other">Ya está guardada. Tienes %1$d modelos disponibles.</item>
    </plurals>
    <string name="key_done">Empezar a crear juegos</string>
    <string name="key_remove">Eliminar la clave guardada</string>
    <string name="key_tips_title">Conviene saber</string>
    <string name="key_tip_private_title">Mantenla en privado</string>
    <string name="key_tip_private_body">Cualquiera con tu clave puede usar tu cuota. No la compartas ni la publiques.</string>
    <string name="key_tip_free_title">Quédate en el nivel gratuito</string>
    <string name="key_tip_free_body">No actives la facturación del proyecto a menos que quieras pagar. Sin facturación, Google simplemente pausa las solicitudes al llegar al límite gratuito.</string>
    <string name="key_tip_privacy_title">Qué se envía</string>
    <string name="key_tip_privacy_body">Tu tema y el texto de Wikipedia se envían a la API de Gemini de Google. En el nivel gratuito Google puede usar estos datos para mejorar sus productos, así que no escribas información personal.</string>
    <string name="key_tip_revoke_title">Revócala o cámbiala</string>
    <string name="key_tip_revoke_body">Puedes borrar la clave en Google AI Studio cuando quieras y pegar una nueva aquí.</string>
    <string name="key_tip_quota_title">¿“Cuota gratuita agotada”?</string>
    <string name="key_tip_quota_body">Las claves gratuitas tienen límites por minuto y por día. Espera un poco o vuelve mañana. Los juegos que ya creaste siguen funcionando sin conexión.</string>
    <string name="key_full_guide">Leer la guía completa con capturas</string>
    <string name="key_guide_url">https://github.com/BrandonVargas/ConceptGames/blob/main/docs/API_KEY_GUIDE.es.md</string>

