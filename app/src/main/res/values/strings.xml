    <!-- API key guide -->
    <string name="key_guide_title">Your free AI key</string>
    <string name="key_intro_title">Why a key?</string>
    <string name="key_intro_body">ConceptGames uses Google\'s Gemini AI to write your games. Gemini has a free tier: create your own key in about two minutes. No credit card needed, and the key is stored encrypted on this phone only.</string>
    <string name="key_step_open_title">Open Google AI Studio</string>
    <string name="key_step_open_body">Sign in with any Google account.</string>
    <string name="key_open_ai_studio">Open Google AI Studio</string>
    <string name="key_step_create_title">Create an API key</string>
    <string name="key_step_create_body">Tap “Create API key”. If you\'re asked to pick a project, the default one is fine, or create a new one.</string>
    <string name="key_step_copy_title">Copy the key</string>
    <string name="key_step_copy_body">It\'s a long code that usually starts with “AIza”. Use the copy button next to it.</string>
    <string name="key_step_paste_title">Paste it here</string>
    <string name="key_step_paste_body">We check it with Google before saving it.</string>
    <string name="key_field_label">Gemini API key</string>
    <string name="key_show">Show key</string>
    <string name="key_hide">Hide key</string>
    <string name="key_paste">Paste</string>
    <string name="key_test">Test and save</string>
    <string name="key_testing">Checking your key with Google…</string>
    <string name="key_valid_title">Your key works!</string>
    <plurals name="key_valid_body">
        <item quantity="one">It\'s saved. %1$d model is available to you.</item>
        <item quantity="other">It\'s saved. %1$d models are available to you.</item>
    </plurals>
    <string name="key_done">Start creating games</string>
    <string name="key_remove">Remove saved key</string>
    <string name="key_tips_title">Good to know</string>
    <string name="key_tip_private_title">Keep it private</string>
    <string name="key_tip_private_body">Anyone with your key can use your quota. Don\'t share it or post it online.</string>
    <string name="key_tip_free_title">Stay on the free tier</string>
    <string name="key_tip_free_body">Don\'t turn on billing for the project unless you want to pay. Without billing, Google simply pauses requests when the free limit is reached.</string>
    <string name="key_tip_privacy_title">What gets sent</string>
    <string name="key_tip_privacy_body">Your topic and the Wikipedia text are sent to Google\'s Gemini API. On the free tier Google may use this data to improve its products, so don\'t type personal information.</string>
    <string name="key_tip_revoke_title">Revoke or replace it</string>
    <string name="key_tip_revoke_body">You can delete the key in Google AI Studio at any time and paste a new one here.</string>
    <string name="key_tip_quota_title">“Free quota reached”?</string>
    <string name="key_tip_quota_body">Free keys have per-minute and daily limits. Wait a bit or try again tomorrow. Games you already created keep working offline.</string>
    <string name="key_full_guide">Read the full guide with screenshots</string>
    <string name="key_guide_url">https://github.com/BrandonVargas/ConceptGames/blob/main/docs/API_KEY_GUIDE.md</string>

