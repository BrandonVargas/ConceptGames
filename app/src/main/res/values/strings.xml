    <!-- Onboarding -->
    <string name="onboarding_title">Learn anything by playing</string>
    <string name="onboarding_subtitle">Type a topic. ConceptGames reads about it on Wikipedia and the web, and Google\'s Gemini AI turns it into minigames.</string>
